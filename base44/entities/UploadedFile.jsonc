{
  "name": "UploadedFile",
  "type": "object",
  "properties": {
    "file_uri": {
      "type": "string",
      "description": "Private storage URI of the uploaded document"
    }
  },
  "required": [
    "file_uri"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}